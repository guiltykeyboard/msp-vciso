    {
      "name": "integrations",
      "item": [
        {
          "name": "List Microsoft Connections",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/integrations/microsoft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "integrations",
                "microsoft"
              ]
            },
            "description": "List redacted tenant-visible Microsoft connections."
          }
        },
        {
          "name": "Create Microsoft Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/integrations/microsoft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "integrations",
                "microsoft"
              ]
            },
            "description": "Store a tenant-mapped Graph connection with an encrypted secret.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"<uuid>\",\n  \"client_secret\": \"<value>\",\n  \"cloud\": \"<value>\",\n  \"display_name\": \"<value>\",\n  \"external_tenant_id\": \"<uuid>\"\n}",
