{
  "info": {
    "name": "Watchtower GRC API",
    "description": "Watchtower's versioned HTTP API for MSP, customer, auditor, evidence, and assessment workflows. The X-Watchtower headers currently shown on tenant endpoints are an insecure development adapter, not production authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "assessments",
      "item": [
        {
          "name": "List assessments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assessments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assessments"
              ]
            },
            "description": "List assessments; RLS supplies the mandatory tenant predicate."
          }
        },
        {
          "name": "Create an assessment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assessments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assessments"
              ]
            },
            "description": "Create an assessment inside the active tenant transaction.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"framework_pack_version_id\": 0,\n  \"name\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "client access",
      "item": [
        {
          "name": "List client access profiles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/access/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "access",
                "roles"
              ]
            },
            "description": "Return the auditable role profiles that may be granted to client personnel."
          }
        },
        {
          "name": "List client invitations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/invitations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "invitations"
              ]
            },
            "description": "List redacted invitation state for the active tenant."
          }
        },
        {
          "name": "Invite client personnel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/invitations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "invitations"
              ]
            },
            "description": "Create a one-time tenant invitation and return its bearer token once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"<value>\",\n  \"email\": \"<value>\",\n  \"expires_in_days\": 0,\n  \"role\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Revoke a client invitation",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/invitations/:invitation_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "invitations",
                ":invitation_id"
              ],
              "variable": [
                {
                  "key": "invitation_id",
                  "value": "<invitation_id>"
                }
              ]
            },
            "description": "Revoke an unconsumed invitation in the active tenant."
          }
        },
        {
          "name": "Accept a client invitation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/invitations:accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "invitations:accept"
              ]
            },
            "description": "Atomically consume a bearer invitation and establish development access.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"<value>\",\n  \"token\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "endpoints",
      "item": [
        {
          "name": "Create Agent Enrollment Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/agent-enrollment-tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agent-enrollment-tokens"
              ]
            },
            "description": "Issue a site-bound enrollment token and store only its hash.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"allowed_platforms\": [\n    \"<value>\"\n  ],\n  \"expires_at\": \"<date-time>\",\n  \"max_uses\": 0,\n  \"site_id\": \"<uuid>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Exchange Agent Enrollment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/agent-enrollments:exchange",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agent-enrollments:exchange"
              ]
            },
            "description": "Atomically consume an enrollment use and return a per-device credential once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agent_version\": \"<value>\",\n  \"hostname\": \"<value>\",\n  \"platform\": \"<value>\",\n  \"public_key\": \"<value>\",\n  \"token\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Agent Check In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "<authorization>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/agents/:device_id/check-ins",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agents",
                ":device_id",
                "check-ins"
              ],
              "variable": [
                {
                  "key": "device_id",
                  "value": "<device_id>"
                }
              ]
            },
            "description": "Accept an idempotent posture observation authenticated by device credential.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"facts\": {},\n  \"idempotency_key\": \"<uuid>\",\n  \"observed_at\": \"<date-time>\",\n  \"schema_version\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create Site",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sites"
              ]
            },
            "description": "Create a tenant site for endpoint enrollment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "evidence",
      "item": [
        {
          "name": "List assessment evidence",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assessments/:assessment_id/evidence",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assessments",
                ":assessment_id",
                "evidence"
              ],
              "variable": [
                {
                  "key": "assessment_id",
                  "value": "<assessment_id>"
                }
              ]
            },
            "description": "List evidence and latest reviews for one tenant-visible assessment."
          }
        },
        {
          "name": "Register an evidence observation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assessments/:assessment_id/evidence",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assessments",
                ":assessment_id",
                "evidence"
              ],
              "variable": [
                {
                  "key": "assessment_id",
                  "value": "<assessment_id>"
                }
              ]
            },
            "description": "Register immutable evidence provenance under an authorized assessment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"artifact_name\": \"<value>\",\n  \"byte_size\": 0,\n  \"collection_method\": \"<value>\",\n  \"description\": \"<value>\",\n  \"media_type\": \"<value>\",\n  \"normalized_facts\": {},\n  \"observed_at\": \"<date-time>\",\n  \"sensitivity\": \"<value>\",\n  \"sha256\": \"<value>\",\n  \"source_identifier\": \"<value>\",\n  \"source_type\": \"<value>\",\n  \"title\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create a direct evidence upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assessments/:assessment_id/evidence/uploads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assessments",
                ":assessment_id",
                "evidence",
                "uploads"
              ],
              "variable": [
                {
                  "key": "assessment_id",
                  "value": "<assessment_id>"
                }
              ]
            },
            "description": "Authorize one short-lived upload without proxying artifact bytes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"artifact_name\": \"<value>\",\n  \"byte_size\": 0,\n  \"collection_method\": \"<value>\",\n  \"description\": \"<value>\",\n  \"media_type\": \"<value>\",\n  \"normalized_facts\": {},\n  \"observed_at\": \"<date-time>\",\n  \"sensitivity\": \"<value>\",\n  \"sha256\": \"<value>\",\n  \"source_identifier\": \"<value>\",\n  \"source_type\": \"<value>\",\n  \"title\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get evidence retention defaults",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence-retention-policy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence-retention-policy"
              ]
            },
            "description": "Return tenant defaults, including safe no-lock behavior when unset."
          }
        },
        {
          "name": "Set evidence retention defaults",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence-retention-policy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence-retention-policy"
              ]
            },
            "description": "Set retention defaults for future artifacts; existing holds remain unchanged.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object_lock_mode\": \"<value>\",\n  \"retention_days\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify and complete an evidence upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/uploads/:upload_id/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                "uploads",
                ":upload_id",
                "complete"
              ],
              "variable": [
                {
                  "key": "upload_id",
                  "value": "<upload_id>"
                }
              ]
            },
            "description": "Verify object integrity before committing an immutable observation."
          }
        },
        {
          "name": "Authorize an evidence artifact download",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/:evidence_id/artifact/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                ":evidence_id",
                "artifact",
                "download"
              ],
              "variable": [
                {
                  "key": "evidence_id",
                  "value": "<evidence_id>"
                }
              ]
            },
            "description": "Issue a short-lived read URL only after a clean malware scan."
          }
        },
        {
          "name": "Set an evidence legal hold",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/:evidence_id/legal-hold",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                ":evidence_id",
                "legal-hold"
              ],
              "variable": [
                {
                  "key": "evidence_id",
                  "value": "<evidence_id>"
                }
              ]
            },
            "description": "Set or release a legal hold without deleting or rewriting evidence.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false,\n  \"reason\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Review an evidence observation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/:evidence_id/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                ":evidence_id",
                "reviews"
              ],
              "variable": [
                {
                  "key": "evidence_id",
                  "value": "<evidence_id>"
                }
              ]
            },
            "description": "Append a human decision without rewriting the evidence or prior reviews.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"<value>\",\n  \"rationale\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Record an evidence malware-scan result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/:evidence_id/scan-result",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                ":evidence_id",
                "scan-result"
              ],
              "variable": [
                {
                  "key": "evidence_id",
                  "value": "<evidence_id>"
                }
              ]
            },
            "description": "Record a scanner result while retaining every transition in the audit ledger.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"detail\": \"<value>\",\n  \"engine\": \"<value>\",\n  \"status\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
