{
  "info": {
    "name": "Watchtower GRC API",
    "description": "Watchtower's versioned HTTP API for MSP, customer, auditor, evidence, and assessment workflows. The X-Watchtower headers currently shown on tenant endpoints are an insecure development adapter, not production authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "assessments",
      "item": [
        {
          "name": "List assessments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assessments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assessments"
              ]
            },
            "description": "List assessments; RLS supplies the mandatory tenant predicate."
          }
        },
        {
          "name": "Create an assessment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assessments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assessments"
              ]
            },
            "description": "Create an assessment inside the active tenant transaction.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"framework_pack_version_id\": 0,\n  \"name\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "evidence",
      "item": [
        {
          "name": "List assessment evidence",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assessments/:assessment_id/evidence",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assessments",
                ":assessment_id",
                "evidence"
              ],
              "variable": [
                {
                  "key": "assessment_id",
                  "value": "<assessment_id>"
                }
              ]
            },
            "description": "List evidence and latest reviews for one tenant-visible assessment."
          }
        },
        {
          "name": "Register an evidence observation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assessments/:assessment_id/evidence",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assessments",
                ":assessment_id",
                "evidence"
              ],
              "variable": [
                {
                  "key": "assessment_id",
                  "value": "<assessment_id>"
                }
              ]
            },
            "description": "Register immutable evidence provenance under an authorized assessment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"artifact_name\": \"<value>\",\n  \"byte_size\": 0,\n  \"collection_method\": \"<value>\",\n  \"description\": \"<value>\",\n  \"media_type\": \"<value>\",\n  \"normalized_facts\": {},\n  \"observed_at\": \"<date-time>\",\n  \"sensitivity\": \"<value>\",\n  \"sha256\": \"<value>\",\n  \"source_identifier\": \"<value>\",\n  \"source_type\": \"<value>\",\n  \"title\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create a direct evidence upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/assessments/:assessment_id/evidence/uploads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "assessments",
                ":assessment_id",
                "evidence",
                "uploads"
              ],
              "variable": [
                {
                  "key": "assessment_id",
                  "value": "<assessment_id>"
                }
              ]
            },
            "description": "Authorize one short-lived upload without proxying artifact bytes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"artifact_name\": \"<value>\",\n  \"byte_size\": 0,\n  \"collection_method\": \"<value>\",\n  \"description\": \"<value>\",\n  \"media_type\": \"<value>\",\n  \"normalized_facts\": {},\n  \"observed_at\": \"<date-time>\",\n  \"sensitivity\": \"<value>\",\n  \"sha256\": \"<value>\",\n  \"source_identifier\": \"<value>\",\n  \"source_type\": \"<value>\",\n  \"title\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get evidence retention defaults",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence-retention-policy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence-retention-policy"
              ]
            },
            "description": "Return tenant defaults, including safe no-lock behavior when unset."
          }
        },
        {
          "name": "Set evidence retention defaults",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence-retention-policy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence-retention-policy"
              ]
            },
            "description": "Set retention defaults for future artifacts; existing holds remain unchanged.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object_lock_mode\": \"<value>\",\n  \"retention_days\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify and complete an evidence upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/uploads/:upload_id/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                "uploads",
                ":upload_id",
                "complete"
              ],
              "variable": [
                {
                  "key": "upload_id",
                  "value": "<upload_id>"
                }
              ]
            },
            "description": "Verify object integrity before committing an immutable observation."
          }
        },
        {
          "name": "Authorize an evidence artifact download",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/:evidence_id/artifact/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                ":evidence_id",
                "artifact",
                "download"
              ],
              "variable": [
                {
                  "key": "evidence_id",
                  "value": "<evidence_id>"
                }
              ]
            },
            "description": "Issue a short-lived read URL only after a clean malware scan."
          }
        },
        {
          "name": "Set an evidence legal hold",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/:evidence_id/legal-hold",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                ":evidence_id",
                "legal-hold"
              ],
              "variable": [
                {
                  "key": "evidence_id",
                  "value": "<evidence_id>"
                }
              ]
            },
            "description": "Set or release a legal hold without deleting or rewriting evidence.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false,\n  \"reason\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Review an evidence observation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/:evidence_id/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                ":evidence_id",
                "reviews"
              ],
              "variable": [
                {
                  "key": "evidence_id",
                  "value": "<evidence_id>"
                }
              ]
            },
            "description": "Append a human decision without rewriting the evidence or prior reviews.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"<value>\",\n  \"rationale\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Record an evidence malware-scan result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/evidence/:evidence_id/scan-result",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "evidence",
                ":evidence_id",
                "scan-result"
              ],
              "variable": [
                {
                  "key": "evidence_id",
                  "value": "<evidence_id>"
                }
              ]
            },
            "description": "Record a scanner result while retaining every transition in the audit ledger.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"detail\": \"<value>\",\n  \"engine\": \"<value>\",\n  \"status\": \"<value>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "health",
      "item": [
        {
          "name": "Check process liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            },
            "description": "Return process liveness without touching a dependency."
          }
        },
        {
          "name": "Check database readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "description": "Return readiness only after PostgreSQL accepts a query."
          }
        }
      ]
    },
    {
      "name": "tenancy",
      "item": [
        {
          "name": "Get the current organization",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Watchtower-Organization",
                "value": "<X-Watchtower-Organization>"
              },
              {
                "key": "X-Watchtower-Actor",
                "value": "<X-Watchtower-Actor>"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/organization",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "organization"
              ]
            },
            "description": "Return the organization selected by the authorized tenant context."
          }
        }
      ]
    }
  ]
}
