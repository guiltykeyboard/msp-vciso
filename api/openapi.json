{
  "components": {
    "schemas": {
      "AssessmentCreate": {
        "description": "Fields accepted when opening an assessment.",
        "properties": {
          "framework_pack_version_id": {
            "exclusiveMinimum": 0.0,
            "title": "Framework Pack Version Id",
            "type": "integer"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "framework_pack_version_id",
          "name"
        ],
        "title": "AssessmentCreate",
        "type": "object"
      },
      "AssessmentResponse": {
        "description": "Tenant-scoped assessment representation.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "framework_pack_version_id": {
            "title": "Framework Pack Version Id",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "framework_pack_version_id",
          "created_at"
        ],
        "title": "AssessmentResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OrganizationResponse": {
        "description": "Tenant organization visible in the active request context.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ],
        "title": "OrganizationResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Watchtower GRC maintainers",
      "url": "https://github.com/guiltykeyboard/msp-vciso"
    },
    "description": "Watchtower's versioned HTTP API for MSP, customer, auditor, evidence, and assessment workflows. The X-Watchtower headers currently shown on tenant endpoints are an insecure development adapter, not production authentication.",
    "license": {
      "identifier": "AGPL-3.0-only",
      "name": "GNU Affero General Public License v3.0"
    },
    "summary": "Tenant-safe compliance and evidence automation for MSPs",
    "title": "Watchtower GRC API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Return process liveness without touching a dependency.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Getliveness",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Return readiness only after PostgreSQL accepts a query.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Getreadiness",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check database readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/assessments": {
      "get": {
        "description": "List assessments; RLS supplies the mandatory tenant predicate.",
        "operationId": "listAssessments",
        "parameters": [
          {
            "in": "header",
            "name": "X-Watchtower-Organization",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Organization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Watchtower-Actor",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Actor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AssessmentResponse"
                  },
                  "title": "Response Listassessments",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List assessments",
        "tags": [
          "assessments"
        ]
      },
      "post": {
        "description": "Create an assessment inside the active tenant transaction.",
        "operationId": "createAssessment",
        "parameters": [
          {
            "in": "header",
            "name": "X-Watchtower-Organization",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Organization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Watchtower-Actor",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Actor",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssessmentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create an assessment",
        "tags": [
          "assessments"
        ]
      }
    },
    "/v1/organization": {
      "get": {
        "description": "Return the organization selected by the authorized tenant context.",
        "operationId": "getCurrentOrganization",
        "parameters": [
          {
            "in": "header",
            "name": "X-Watchtower-Organization",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Organization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Watchtower-Actor",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Actor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get the current organization",
        "tags": [
          "tenancy"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Process and dependency health checks.",
      "name": "health"
    },
    {
      "description": "The organization authorized for the current request.",
      "name": "tenancy"
    },
    {
      "description": "Tenant-isolated compliance assessment operations.",
      "name": "assessments"
    }
  ]
}
