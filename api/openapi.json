{
  "components": {
    "schemas": {
      "AssessmentCreate": {
        "description": "Fields accepted when opening an assessment.",
        "properties": {
          "framework_pack_version_id": {
            "exclusiveMinimum": 0.0,
            "title": "Framework Pack Version Id",
            "type": "integer"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "framework_pack_version_id",
          "name"
        ],
        "title": "AssessmentCreate",
        "type": "object"
      },
      "AssessmentResponse": {
        "description": "Tenant-scoped assessment representation.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "framework_pack_version_id": {
            "title": "Framework Pack Version Id",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "framework_pack_version_id",
          "created_at"
        ],
        "title": "AssessmentResponse",
        "type": "object"
      },
      "EvidenceDownloadResponse": {
        "description": "Short-lived read authorization for a clean evidence artifact.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expires_at"
        ],
        "title": "EvidenceDownloadResponse",
        "type": "object"
      },
      "EvidenceLegalHoldUpdate": {
        "description": "Explicit legal-hold transition and its required justification.",
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "EvidenceLegalHoldUpdate",
        "type": "object"
      },
      "EvidenceLifecycleResponse": {
        "description": "Operational scan, retention, and legal-hold state.",
        "properties": {
          "legal_hold": {
            "title": "Legal Hold",
            "type": "boolean"
          },
          "legal_hold_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Legal Hold Reason"
          },
          "object_lock_mode": {
            "enum": [
              "none",
              "governance",
              "compliance"
            ],
            "title": "Object Lock Mode",
            "type": "string"
          },
          "retention_until": {
            "format": "date-time",
            "title": "Retention Until",
            "type": "string"
          },
          "scan_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scan Detail"
          },
          "scan_engine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scan Engine"
          },
          "scan_status": {
            "enum": [
              "pending",
              "clean",
              "quarantined",
              "error"
            ],
            "title": "Scan Status",
            "type": "string"
          },
          "scanned_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scanned At"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "scan_status",
          "scan_engine",
          "scan_detail",
          "scanned_at",
          "retention_until",
          "object_lock_mode",
          "legal_hold",
          "legal_hold_reason",
          "updated_at"
        ],
        "title": "EvidenceLifecycleResponse",
        "type": "object"
      },
      "EvidenceObservationCreate": {
        "description": "Provenance and integrity metadata for a newly received artifact.",
        "properties": {
          "artifact_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Artifact Name",
            "type": "string"
          },
          "byte_size": {
            "maximum": 5368709120.0,
            "minimum": 0.0,
            "title": "Byte Size",
            "type": "integer"
          },
          "collection_method": {
            "default": "manual",
            "enum": [
              "manual",
              "api",
              "endpoint",
              "browser",
              "import"
            ],
            "title": "Collection Method",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "media_type": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Media Type",
            "type": "string"
          },
          "normalized_facts": {
            "additionalProperties": true,
            "title": "Normalized Facts",
            "type": "object"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "sensitivity": {
            "default": "confidential",
            "enum": [
              "internal",
              "confidential",
              "security_record",
              "cji"
            ],
            "title": "Sensitivity",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "source_identifier": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Identifier"
          },
          "source_type": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Source Type",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "source_type",
          "observed_at",
          "artifact_name",
          "media_type",
          "byte_size",
          "sha256"
        ],
        "title": "EvidenceObservationCreate",
        "type": "object"
      },
      "EvidenceObservationResponse": {
        "description": "Tenant-scoped evidence metadata and its latest review decision.",
        "properties": {
          "artifact_name": {
            "title": "Artifact Name",
            "type": "string"
          },
          "assessment_id": {
            "format": "uuid",
            "title": "Assessment Id",
            "type": "string"
          },
          "byte_size": {
            "title": "Byte Size",
            "type": "integer"
          },
          "collection_method": {
            "enum": [
              "manual",
              "api",
              "endpoint",
              "browser",
              "import"
            ],
            "title": "Collection Method",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "latest_review": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvidenceReviewResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "lifecycle": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvidenceLifecycleResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "normalized_facts": {
            "additionalProperties": true,
            "title": "Normalized Facts",
            "type": "object"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "sensitivity": {
            "enum": [
              "internal",
              "confidential",
              "security_record",
              "cji"
            ],
            "title": "Sensitivity",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "source_identifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Identifier"
          },
          "source_type": {
            "title": "Source Type",
            "type": "string"
          },
          "storage_provider": {
            "anyOf": [
              {
                "enum": [
                  "azure",
                  "s3"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Storage Provider"
          },
          "submitted_by": {
            "format": "uuid",
            "title": "Submitted By",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "assessment_id",
          "title",
          "description",
          "collection_method",
          "source_type",
          "source_identifier",
          "observed_at",
          "received_at",
          "artifact_name",
          "media_type",
          "byte_size",
          "sha256",
          "sensitivity",
          "normalized_facts",
          "submitted_by"
        ],
        "title": "EvidenceObservationResponse",
        "type": "object"
      },
      "EvidenceRetentionPolicyResponse": {
        "description": "Current tenant retention defaults.",
        "properties": {
          "object_lock_mode": {
            "default": "none",
            "enum": [
              "none",
              "governance",
              "compliance"
            ],
            "title": "Object Lock Mode",
            "type": "string"
          },
          "retention_days": {
            "maximum": 36500.0,
            "minimum": 1.0,
            "title": "Retention Days",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "retention_days",
          "updated_at"
        ],
        "title": "EvidenceRetentionPolicyResponse",
        "type": "object"
      },
      "EvidenceRetentionPolicyUpdate": {
        "description": "Tenant-wide defaults for newly committed evidence artifacts.",
        "properties": {
          "object_lock_mode": {
            "default": "none",
            "enum": [
              "none",
              "governance",
              "compliance"
            ],
            "title": "Object Lock Mode",
            "type": "string"
          },
          "retention_days": {
            "maximum": 36500.0,
            "minimum": 1.0,
            "title": "Retention Days",
            "type": "integer"
          }
        },
        "required": [
          "retention_days"
        ],
        "title": "EvidenceRetentionPolicyUpdate",
        "type": "object"
      },
      "EvidenceReviewCreate": {
        "description": "A human review decision appended to an evidence observation.",
        "properties": {
          "decision": {
            "enum": [
              "accepted",
              "rejected"
            ],
            "title": "Decision",
            "type": "string"
          },
          "rationale": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "rationale"
        ],
        "title": "EvidenceReviewCreate",
        "type": "object"
      },
      "EvidenceReviewResponse": {
        "description": "An immutable evidence review ledger entry.",
        "properties": {
          "decision": {
            "enum": [
              "accepted",
              "rejected"
            ],
            "title": "Decision",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "reviewed_at": {
            "format": "date-time",
            "title": "Reviewed At",
            "type": "string"
          },
          "reviewed_by": {
            "format": "uuid",
            "title": "Reviewed By",
            "type": "string"
          }
        },
        "required": [
          "id",
          "decision",
          "rationale",
          "reviewed_by",
          "reviewed_at"
        ],
        "title": "EvidenceReviewResponse",
        "type": "object"
      },
      "EvidenceScanResult": {
        "description": "Result submitted by an authorized malware-scanning worker.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "engine": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Engine",
            "type": "string"
          },
          "status": {
            "enum": [
              "clean",
              "quarantined",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "engine"
        ],
        "title": "EvidenceScanResult",
        "type": "object"
      },
      "EvidenceUploadResponse": {
        "description": "Short-lived instructions for uploading an artifact directly to storage.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Headers",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "method": {
            "const": "PUT",
            "title": "Method",
            "type": "string"
          },
          "provider": {
            "enum": [
              "azure",
              "s3"
            ],
            "title": "Provider",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "method",
          "url",
          "headers",
          "expires_at"
        ],
        "title": "EvidenceUploadResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OrganizationResponse": {
        "description": "Tenant organization visible in the active request context.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ],
        "title": "OrganizationResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Watchtower GRC maintainers",
      "url": "https://github.com/guiltykeyboard/msp-vciso"
    },
    "description": "Watchtower's versioned HTTP API for MSP, customer, auditor, evidence, and assessment workflows. The X-Watchtower headers currently shown on tenant endpoints are an insecure development adapter, not production authentication.",
    "license": {
      "identifier": "AGPL-3.0-only",
      "name": "GNU Affero General Public License v3.0"
    },
    "summary": "Tenant-safe compliance and evidence automation for MSPs",
    "title": "Watchtower GRC API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Return process liveness without touching a dependency.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Getliveness",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Return readiness only after PostgreSQL accepts a query.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Getreadiness",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check database readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/assessments": {
      "get": {
        "description": "List assessments; RLS supplies the mandatory tenant predicate.",
        "operationId": "listAssessments",
        "parameters": [
          {
            "in": "header",
            "name": "X-Watchtower-Organization",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Organization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Watchtower-Actor",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Actor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AssessmentResponse"
                  },
                  "title": "Response Listassessments",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List assessments",
        "tags": [
          "assessments"
        ]
      },
      "post": {
        "description": "Create an assessment inside the active tenant transaction.",
        "operationId": "createAssessment",
        "parameters": [
          {
            "in": "header",
            "name": "X-Watchtower-Organization",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Organization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Watchtower-Actor",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Actor",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssessmentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create an assessment",
        "tags": [
          "assessments"
        ]
      }
    },
    "/v1/assessments/{assessment_id}/evidence": {
      "get": {
        "description": "List evidence and latest reviews for one tenant-visible assessment.",
        "operationId": "listAssessmentEvidence",
        "parameters": [
          {
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Assessment Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Watchtower-Organization",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Organization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Watchtower-Actor",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Actor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EvidenceObservationResponse"
                  },
                  "title": "Response Listassessmentevidence",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List assessment evidence",
        "tags": [
          "evidence"
        ]
      },
      "post": {
        "description": "Register immutable evidence provenance under an authorized assessment.",
        "operationId": "createEvidenceObservation",
        "parameters": [
          {
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Assessment Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Watchtower-Organization",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Organization",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Watchtower-Actor",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "X-Watchtower-Actor",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceObservationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
